/*--------------------------------------------

TEST: same demonstration system as test-prism.lens, but with the prism's
base flipped to "down" - shows the image-height shift reversing direction
while the image location/magnification (from the lens alone) stay the same.

Dimensions match thin-lens-positive.lens's scale/convention (object at
z=-0.3, h=0.1, lens height=0.5/aperture=0.25) rather than a physically
realistic mm scale, for visual consistency with the other thin lens
examples.

----------------------------------------------*/

{

	"viewBox" : [ -1.0, 0.5, 2.5, 1.0 ],

	"general" :  { "cardinalVertHeight" : 0.02 },

	"sources" : [ { "id" 		: 1,
					"type" 		: "object",
					"which"		: "object",
					"infinity"	: false,
					"beamwidth" : 0.1,
					"z"			: -0.3,
					"h"			: 0.1 } ],

	"title": "Test Prism (10 Base-Down Prism + Thin Lens)",
    "prescription": [{
		"id": "0001",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000
		}
	}, {
		"id": "0002",
		"type": "prism",
		"description": "10 base-down prism",
		"args": {
			"power": 10,
			"base": "down",
			"height": 0.5,
			"aperture": 0.25
		}
	}, {
		"id": "0003",
		"type": "index",
		"description": "air gap",
		"args": {
			"index": 1.000,
			"thickness": 0.2
		}
	}, {
		"id": "0004",
		"type": "thin",
		"description": "converging lens",
		"args": {
			"power": 5,
			"height": 0.5,
			"aperture": 0.25
		}
	}, {
		"id": "0005",
		"type": "index",
		"description": "air#2",
		"args": {
			"index": 1.000
		}
	}]
}
