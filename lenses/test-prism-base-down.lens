/*--------------------------------------------

TEST: same demonstration system as test-prism.lens, but with the prism's
base flipped to "down" - shows the image-height shift reversing direction
while the image location/magnification (from the lens alone) stay the same.

----------------------------------------------*/

{

	"viewBox" : [ -0.3, 0.05, 0.6, 0.1 ],

	"general" :  { "cardinalVertHeight" : 0.002 },

	"sources" : [ { "id" 		: 1,
					"type" 		: "object",
					"which"		: "object",
					"infinity"	: false,
					"beamwidth" : 0.01,
					"z"			: -0.2,
					"h"			: 0.01 } ],

	"title": "Test Prism (10 Base-Down Prism + Thin Lens)",
    "prescription": [{
		"id": "0001",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000
		}
	}, {
		"id": "0002",
		"type": "prism",
		"description": "10 base-down prism",
		"args": {
			"power": 10,
			"base": "down",
			"height": 0.03
		}
	}, {
		"id": "0003",
		"type": "index",
		"description": "air gap",
		"args": {
			"index": 1.000,
			"thickness": 0.05
		}
	}, {
		"id": "0004",
		"type": "thin",
		"description": "converging lens",
		"args": {
			"power": 20,
			"height": 0.03
		}
	}, {
		"id": "0005",
