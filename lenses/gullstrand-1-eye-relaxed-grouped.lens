/*--------------------------------------------

 Gullstrand 1 Eye Relaxed (grouped)

 Same model as gullstrand-1-eye-relaxed.lens - this variant existed to
 group the cornea/lens surfaces together, but originally did so with a
 "type": "group" / "data": [...] wrapper that nothing in the app actually
 understands (only a flat "prescription" array with an optional per-entry
 "group" string tag is supported - see optics.js's group lookup helpers).
 It also predated the "units" field and was still authored in millimetres
 (1000x too large for its own geometry) with only a placeholder aperture.
 Rehabilitated to the same flat, group-tagged, metres-based structure as
 the working sibling file.

----------------------------------------------*/
{
	"title": "Gullstrand 1 eye relaxed (grouped)",
	"units" : "m",
	"visible": { 	"radius": true,
				 	"power":true,
				 	"curvature":true,
				 	"aperture":true },
	"viewBox" : [ -0.0125, 0.00875, 0.050, 0.0175 ],

	"objects": 	[ 	{ "type": "object", "VO" : -1, "OQ" : 1 },
	 				{ "type": "image",  "VI" : 3, "IQ" : -1 } ],
	"sources" : [ { "id" 		: 1,
					"type" 		: "object",
					"infinity"	: true,
					"which"		: "object",
					"beamwidth" : 0.004,
					"z"			: NaN,
					"h"			: NaN,
					"t"			: 10 } ],

	"prescription": [{
		"id": "0001",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000
		}
	}, {
		"id": "0002",
		"group": "cornea",
		"type": "sphere",
		"description": "anterior cornea",
		"args": {
			"radius": 0.0077,
			"height": 0.012,
			"aperture": 0.012
		}
	}, {
		"id": "0003",
		"group": "cornea",
		"type": "index",
		"description": "stroma",
		"args": {
			"index": 1.376,
			"thickness": 0.0005
		}
	}, {
		"id": "0004",
		"group": "cornea",
		"type": "sphere",
		"description": "posterior cornea",
		"args": {
			"radius": 0.0068,
			"height": 0.012,
			"aperture": 0.012
		}
	}, {
		"id": "0005",
		"type": "index",
		"description": "aqueous",
		"args": {
			"index": 1.336,
			"thickness": 0.0031
		}
	}, {
		"id": "0006",
		"group": "lens",
		"type": "sphere",
		"description": "anterior lens",
		"args": {
			"radius"   : 0.01,
			"stop"     : true,
			"height"   : 0.00957084543,
			"aperture" : 0.004
		}
	}, {
		"id": "0007",
		"group": "lens",
		"type": "index",
		"description": "lens: cortex",
		"args": {
			"index": 1.386,
			"thickness": 0.000546
		}
	}, {
		"id": "0008",
		"group": "lens",
		"type": "sphere",
		"description": "anterior core",
		"args": {
			"radius": 0.007911,
			"height": 0.00762138561,
			"aperture": 0.00762138561
		}
	}, {
		"id": "0009",
		"group": "lens",
		"type": "index",
		"description": "lens: core",
		"args": {
			"index": 1.406,
			"thickness": 0.002419
		}
	}, {
		"id": "0010",
		"group": "lens",
		"type": "sphere",
		"description": "posterior core",
		"args": {
			"radius": -0.00576,
