/*--------------------------------------------

 Keplerian Telescope with a manual (explicit) aperture stop

 Same objective/eyepiece prescription as keplerian-telescope.lens, but the
 stop is moved off the objective and onto a standalone "stop" element (see
 optics.js's getLensElementInfo "stop" case) placed at the telescope's real
 intermediate image - 0.1m behind the objective (its back focal distance,
 f = 1/10 D), which is also 0.05m in front of the eyepiece (its front focal
 distance, f = 1/20 D), splitting the original single 0.15m air gap into
 two. A "stop" element is always treated as the system's aperture stop (no
 args.stop needed), demonstrating that this works standalone - not attached
 to any real refracting surface - and at a non-trivial position, including
 for an afocal system (this telescope has zero equivalent power).

 The stop's own aperture (0.02m) is deliberately the tightest in the system,
 so it is genuinely the limiting element - not just flagged as such.

----------------------------------------------*/
{
	"category"    : "Instruments",
	"subcategory" : "Telescope",
	"keywords"    : [ "instrument", "telescope", "Keplerian" ],
	"shortName"   : "Keplerian, stop at the intermediate image",
	"about"       : "A Keplerian telescope with a manual aperture stop placed at the intermediate image.",


	"viewBox" : [ -0.05, 0.15, 0.35, 0.3 ],

	"sources" : [ { "id"   		: 1,
                    "type" 		: "object",
                    "which"		: "object",
                    "infinity"	: true,
                    "beamwidth" : 0.15,
                    "z"    		: NaN,
                    "h"    		: NaN,
                    "t"    		: 5 }],

	"title": "Keplerian Telescope with Manual Stop at Intermediate Image",
    "prescription": [{
		"id": "0001",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000
		}
	}, {
		"id": "0002",
		"type": "thin",
		"description": "objective",
		"args": {
			"power":  10,
			"height": 0.2,
			"aperture" : 0.15
		}
	}, {
		"id": "0003",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000,
			"thickness": 0.1
		}
	}, {
		"id": "0004",
		"type": "stop",
		"description": "field stop at intermediate image",
		"args": {
			"height": 0.2,
			"aperture": 0.02
		}
	}, {
		"id": "0005",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000,
			"thickness": 0.05
		}
	}, {
		"id": "0006",
		"type": "thin",
		"description": "eye piece",
		"args": {
			"power":  20,
			"height": 0.2,
			"aperture": 0.1
		}
	}, {
		"id": "0007",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.0
		}
	} ]
}
