/*--------------------------------------------

TEST: dispersion through a base-down prism, lit by white light, focused onto a screen.

The source is a beam from infinity written with the new  "white": true  shorthand - it stands for
a LINKED group of beams, one per wavelength of the white-light group (red, green and blue unless the
Wavelengths dialog says otherwise), which move as one. Written out in full the same thing is three
sources sharing a "group" number, each with its own "wavelength" (nm).

The prism is a thin 100 prism dioptre prism of dense flint (SF11, Abbe number about 26). A thin prism
deviates light by (n - 1) times its angle, so each colour leaves at a slightly different angle: the
beams overlap (and add up to white, with Additive beams on) until they have separated.

"settings" lists what this file needs switched on to make its point: advanced materials (so the index
depends on wavelength), the dark diagram and additive beams (so red + green + blue shows as white).
A thin lens a little way on (f = 170 mm) brings each colour to a focus, and the screen sits at its focal plane,
where the three colours land at slightly different heights - a spectrum.

Change the material of the prism to "Custom" (no material) and the colours stay together.

Click a beam (or drag it) and the Ref. Index column, the Summary and the pupils follow that colour.

----------------------------------------------*/

{
	"category"    : "Components",
	"subcategory" : "Dispersion",
	"keywords"    : [ "dispersion", "advanced materials", "prism", "white light" ],


	"viewBox" : [ -0.3, 0.17, 0.7, 0.34 ],

	"visible" : { "stop": false },

	"settings" : { "advancedMaterials": true, "darkCanvas": true, "additiveBeams": true },

	"sources" : [ { "id" 		: 1,
					"type" 		: "object",
					"which"		: "object",
					"infinity"	: true,
					"draw"		: "rays",
					"white"		: [ 435.8, 514.5, 656.3 ],
					"beamwidth" : 0.01,
					"z"			: NaN,
					"h"			: NaN,
					"t"			: -25 } ],

	"title": "TEST Dispersion: 100 Base-Down Prism (SF11) + lens, white light",
	"prescription": [{
		"id": "0001",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000
		}
	}, {
		"id": "0002",
		"type": "prism",
		"description": "100 base-down prism",
		"args": {
			"power": 100,
			"base": "down",
			"material": "SF11 dense flint",
			"height": 0.16
		}
	}, {
		"id": "0003",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000,
			"thickness": 0.1
		}
	}, {
		"id": "0004",
		"type": "thin",
		"description": "focusing lens (f = 170 mm)",
		"args": {
			"power": 5.8824,
			"height": 0.2
		}
	}, {
		"id": "0005",
		"type": "index",
		"description": "air",
		"args": {
			"index": 1.000,
			"thickness": 0.17
		}
	}, {
		"id": "0006",
		"type": "img",
		"description": "screen (at the focal plane)",
		"args": {
			"radius": Infinity,
			"height": 0.22
		}
	}]
}
