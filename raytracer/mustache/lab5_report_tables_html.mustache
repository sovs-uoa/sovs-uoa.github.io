<h4>Summary</h4>

              <!-- Summary -->
              <table class="table">
                <thead>
                  <tr>
                    <th>name</th>
                    <th>value</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Primary ref. index (n)</td><td>{{n1 | decimal : 5 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{n1 | decimal : 5 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>Secondary ref. index (n')</td><td>{{n2 | decimal : 5 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{n2 | decimal : 5 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>System length (VV') ({{distUnitLabel}})</td><td>{{L | dist : 3 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{L | dist : 3 }}', this)"></i></td>
                  </tr>
                </tbody>
              </table>

<h4>Powers (D)</h4>

              <!-- Powers -->
              <table class="table">
                <thead>
                  <tr>
                    <th>name</th>
                    <th>value</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Equivalent power (F)</td><td>{{powers.F | decimal : 3 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{powers.F | decimal : 3 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>Front vertex power (F<sub>v</sub>)</td><td>{{powers.Fv1 | decimal : 3 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{powers.Fv1 | decimal : 3 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>Back vertex power (F<sub>v'</sub>)</td><td>{{powers.Fv2 | decimal : 3 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{powers.Fv2 | decimal : 3 }}', this)"></i></td>
                  </tr>
                </tbody>
              </table>

<h4>Distances ({{distUnitLabel}})</h4>


              <!-- Distances -->
             <table class="table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Front</th>
                    <th>Back</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Focal lengths</td>
                    <td>{{cardinal.PF1 | dist : 3 }} (PF) <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{cardinal.PF1 | dist : 3 }}', this)"></i></td>
                    <td>{{cardinal.PF2 | dist : 3 }} (P'F') <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{cardinal.PF2 | dist : 3 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>Vertex focal lengths</td>
                    <td>{{cardinal.VF1 | dist : 3 }} (VF) <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{cardinal.VF1 | dist : 3 }}', this)"></i></td>
                    <td>{{cardinal.VF2 | dist : 3 }} (V'F') <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{cardinal.VF2 | dist : 3 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>Principal points</td>
                    <td>{{cardinal.VP1 | dist : 3 }} (VP) <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{cardinal.VP1 | dist : 3 }}', this)"></i></td>
                    <td>{{cardinal.VP2 | dist : 3 }} (V'P') <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{cardinal.VP2 | dist : 3 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>Nodal points</td>
                    <td>{{cardinal.VN1 | dist : 3 }} (VN) <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{cardinal.VN1 | dist : 3 }}', this)"></i></td>
                    <td>{{cardinal.VN2 | dist : 3 }} (V'N') <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{cardinal.VN2 | dist : 3 }}', this)"></i></td>
                  </tr>
                </tbody>
              </table>

<h4>Pupils ({{distUnitLabel}})</h4>
              <table class="table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Position</th>
                    <th>Pupil Mag.</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Entrance</td><td>{{pupil.VE1 | dist : 3 }} (VE) <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{pupil.VE1 | dist : 3 }}', this)"></i></td><td>{{pupil.ME1 | decimal : 3 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{pupil.ME1 | decimal : 3 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>Exit</td><td>{{pupil.VE2 | dist : 3 }} (VE') <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{pupil.VE2 | dist : 3 }}', this)"></i></td><td>{{pupil.ME2 | decimal : 3 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{pupil.ME2 | decimal : 3 }}', this)"></i></td>
                  </tr>
                </tbody>
              </table>

<!-- System -->

<h4>System coefficients</h4>
            <table class="table">
                <thead>
                  <tr>
                    <th>name</th>
                    <th>value</th>
                    <th>name</th>
                    <th>value</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>A</td><td>{{S.A | decimal : 5 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{S.A | decimal : 5 }}', this)"></i></td>
                    <td>B</td><td>{{S.B | decimal : 5 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{S.B | decimal : 5 }}', this)"></i></td>
                  </tr>
                  <tr>
                    <td>C</td><td>{{S.C | decimal : 5 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{S.C | decimal : 5 }}', this)"></i></td>
                    <td>D</td><td>{{S.D | decimal : 5 }} <i class="far fa-copy copy-icon" title="Copy" onclick="copyToClipboard('{{S.D | decimal : 5 }}', this)"></i></td>
                  </tr>
                </tbody>
              </table>
